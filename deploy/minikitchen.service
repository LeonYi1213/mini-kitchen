[Unit]
Description=MiniKitchen private recipe import service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minikitchen
Group=minikitchen
WorkingDirectory=/opt/minikitchen/current
EnvironmentFile=/opt/minikitchen/service.env
Environment=PATH=/opt/minikitchen/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/minikitchen/venv/bin/python /opt/minikitchen/current/backend/server.py --port 18320
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/minikitchen/data

[Install]
WantedBy=multi-user.target
