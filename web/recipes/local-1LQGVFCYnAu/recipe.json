  "prep": [
    "蛏子清洗净沙；蒲瓜切厚片，咸肉、姜、胡萝卜和春笋切片，韭菜切段。"
  ],
  "cook": [
    "蛏子下锅煮至开壳，取出蛏肉备用。",
    "锅放少许油，下咸肉煸香，再下姜蒜炒香。",
    "加入胡萝卜和笋片翻炒，烹入花雕酒。",
    "放蒲瓜厚片，炒至边缘微焦，加入少量水烧软。",
    "放蛏肉，加糖2克、盐1克、生抽5克，稍收汁后加韭菜翻匀装盘。"
  ],
